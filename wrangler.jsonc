{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "embaixadores-forms",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "embaixadores.iamcontrol.com.br/*",
      "zone_name": "iamcontrol.com.br"
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SUPABASE_URL": "https://pmzzvirpyzgfwaqsxqev.supabase.co"
  }
}
